PORT=3000
FRONTEND_URL=http://localhost:5173

# Gere um segredo longo e aleatório. Ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo
JWT_EXPIRA_EM=1h

# Tentativas de login por IP a cada 15 minutos
LOGIN_MAX_TENTATIVAS=10

# memoria = roda sem banco (dados de demonstração recriados a cada start)
# banco   = usa o banco real configurado em src/config/db.js
MODO_BANCO=memoria

# Preenchido pelo responsável pelo banco. Ex. PostgreSQL:
# DATABASE_URL=postgres://usuario:senha@localhost:5432/financas
DATABASE_URL=
