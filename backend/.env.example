PORT=3000
FRONTEND_URL=http://localhost:5173

# Gere um segredo longo e aleatório. Ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo
JWT_EXPIRA_EM=1h

# Tentativas de login por IP a cada 15 minutos
LOGIN_MAX_TENTATIVAS=10

# Conexão com o PostgreSQL (formato: postgres://usuario:senha@host:porta/banco)
# Com o banco do docker-compose (docker compose up -d db), este valor já funciona:
DATABASE_URL=postgres://financas:financas@localhost:5432/financas

# Máximo de conexões abertas no pool
DB_POOL_MAX=10
